{
    "discord": {
        "token": "[discord bot token]",
        "clientId": "[discord app id]"
    },
    "pushover": {
        "url": "https://api.pushover.net/1/messages.json",
        "token": "[pushover app token]",
        "user": "[pushover user key]",
        "device": "[pushover device(s) to send notifications to]"
    },
    "greet_msg": "[message to send in response to /greet]",
    "response_msg": "[message to send in response to dms]",
    "image_callback": "[command to call on the first image of each message]"
}